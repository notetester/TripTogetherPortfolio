<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
    =============================================
    ReportMapper.xml - 신고 게시판 SQL 쿼리 모음
    =============================================
-->
<mapper namespace="org.triptogether.report.mapper.ReportMapper">

    <!-- 신고 매핑 -->
    <resultMap id="ReportResultMap" type="org.triptogether.report.vo.ReportDto">
        <id     property="reportId"          column="report_id"/>
        <result property="userIdx"           column="user_idx"/>
        <result property="targetType"        column="target_type"/>
        <result property="targetId"          column="target_id"/>
        <result property="reason"            column="reason"/>
        <result property="description"       column="description"/>
        <result property="status"            column="status"/>
        <result property="createdAt"         column="created_at"/>
        <result property="resolvedAt"        column="resolved_at"/>
        <result property="updatedAt"         column="updated_at"/>
        <result property="resolverIdx"       column="resolver_idx"/>
        <result property="nickname"          column="nickname"/>
        <result property="targetReportCount" column="target_report_count"/>
    </resultMap>

    <!-- =============================================
         공통 검색 조건 (목록/카운트 공유)
         ============================================= -->
    <sql id="searchWhere">
        <where>
            <if test="status != null and status != ''">
                AND r.status = #{status}
            </if>
            <if test="targetType != null and targetType != ''">
                AND r.target_type = #{targetType}
            </if>
        </where>
    </sql>

    <!-- =============================================
         1. 신고 목록 조회
         - USERS JOIN으로 신고자 닉네임 포함
         - 최신순 정렬, 페이지네이션 적용
         ============================================= -->
    <select id="selectReportList" resultMap="ReportResultMap">
        SELECT
            r.report_id,
            r.user_idx,
            r.target_type,
            r.target_id,
            r.reason,
            r.description,
            r.status,
            r.created_at,
            r.resolved_at,
            r.updated_at,
            r.resolver_idx,
            u.nickname,
            (
                SELECT COUNT(*)
                FROM REPORT r2
                WHERE r2.target_type = r.target_type
                  AND r2.target_id   = r.target_id
            ) AS target_report_count
        FROM REPORT r
        LEFT JOIN USERS u ON r.user_idx = u.user_idx
        <include refid="searchWhere"/>
        ORDER BY r.created_at DESC
        LIMIT #{pageSize} OFFSET #{offset}
    </select>

    <!-- =============================================
         2. 전체 개수 조회
         ============================================= -->
    <select id="selectTotalCount" resultType="int">
        SELECT COUNT(*)
        FROM REPORT r
        <include refid="searchWhere"/>
    </select>

    <!-- =============================================
         3. 신고 단건 조회
         ============================================= -->
    <select id="selectReport" resultMap="ReportResultMap">
        SELECT
            r.report_id,
            r.user_idx,
            r.target_type,
            r.target_id,
            r.reason,
            r.description,
            r.status,
            r.created_at,
            r.resolved_at,
            r.updated_at,
            r.resolver_idx,
            u.nickname
        FROM REPORT r
        LEFT JOIN USERS u ON r.user_idx = u.user_idx
        WHERE r.report_id = #{reportId}
    </select>

    <!-- =============================================
         4. 대상별 신고 수 조회
         ============================================= -->
    <select id="selectReportCountByTarget" resultType="int">
        SELECT COUNT(*)
        FROM REPORT
        WHERE target_type = #{targetType}
          AND target_id   = #{targetId}
    </select>

    <!-- =============================================
         5. 신고 등록
         - INSERT IGNORE: 동일 유저의 중복 신고 방지
         ============================================= -->
    <insert id="insertReport" useGeneratedKeys="true" keyProperty="reportId">
        INSERT IGNORE INTO REPORT (
            user_idx, target_type, target_id,
            reason, description, status, created_at, updated_at
        ) VALUES (
            #{userIdx}, #{targetType}, #{targetId},
            #{reason}, #{description}, 'PENDING', NOW(), NOW()
        )
    </insert>

    <!-- =============================================
         6. 신고 상태 변경
         - status, resolverIdx, resolved_at, updated_at 업데이트
         ============================================= -->
    <update id="updateReportStatus">
        UPDATE REPORT
        SET status       = #{status},
            resolver_idx = #{resolverIdx},
            resolved_at  = NOW(),
            updated_at   = NOW()
        WHERE report_id = #{reportId}
    </update>

</mapper>
