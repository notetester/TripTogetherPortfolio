<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
    =============================================
    MyPageMapper.xml - 마이페이지 SQL 쿼리 모음
    =============================================
-->
<mapper namespace="org.triptogether.myPage.mapper.MyPageMapper">

    <!-- 커뮤니티 매핑 -->
    <resultMap id="CommunityResultMap" type="org.triptogether.myPage.vo.MyPageCommunityDto">
        <id     property="postId"       column="post_id"/>
        <result property="title"        column="title"/>
        <result property="postType"     column="post_type"/>
        <result property="region"       column="region"/>
        <result property="commentCount" column="comment_count"/>
        <result property="likeCount"    column="like_count"/>
        <result property="viewCount"    column="view_count"/>
        <result property="postStatus"   column="post_status"/>
        <result property="createdAt"    column="created_at"/>
    </resultMap>

    <!-- 문의 매핑 -->
    <resultMap id="InquiryResultMap" type="org.triptogether.myPage.vo.MyPageInquiryDto">
        <id     property="inquiryId" column="inquiry_id"/>
        <result property="title"     column="title"/>
        <result property="category"  column="category"/>
        <result property="status"    column="status"/>
        <result property="isPrivate" column="is_private"/>
        <result property="viewCount" column="view_count"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <!-- 신고 매핑 -->
    <resultMap id="ReportResultMap" type="org.triptogether.myPage.vo.MyPageReportDto">
        <id     property="reportId"   column="report_id"/>
        <result property="targetType" column="target_type"/>
        <result property="targetId"   column="target_id"/>
        <result property="reason"     column="reason"/>
        <result property="status"     column="status"/>
        <result property="createdAt"  column="created_at"/>
    </resultMap>

    <!-- 알림 매핑 -->
    <resultMap id="FeedNotificationResultMap" type="org.triptogether.myPage.vo.FeedNotificationDto">
        <id     property="notificationId" column="notification_id"/>
        <result property="userIdx"        column="user_idx"/>
        <result property="sourceType"     column="source_type"/>
        <result property="sourceId"       column="source_id"/>
        <result property="message"        column="message"/>
        <result property="createdAt"      column="created_at"/>
    </resultMap>

    <!-- =============================================
         1. 내 커뮤니티 글 목록 조회
         - ACTIVE 상태 글만, 최신순 10개
         ============================================= -->
    <select id="selectMyCommunityList" resultMap="CommunityResultMap">
        SELECT
            post_id,
            title,
            post_type,
            region,
            comment_count,
            like_count,
            view_count,
            post_status,
            created_at
        FROM COMMUNITY_POST
        WHERE user_idx   = #{userIdx}
          AND post_status = 'ACTIVE'
        ORDER BY created_at DESC
        LIMIT 10
    </select>

    <!-- =============================================
         2. 내 커뮤니티 글 총 개수 조회
         ============================================= -->
    <select id="selectMyCommunityCount" resultType="int">
        SELECT COUNT(*)
        FROM COMMUNITY_POST
        WHERE user_idx   = #{userIdx}
          AND post_status = 'ACTIVE'
    </select>

    <!-- =============================================
         3. 내 문의 글 목록 조회
         - 최신순 10개
         ============================================= -->
    <select id="selectMyInquiryList" resultMap="InquiryResultMap">
        SELECT
            inquiry_id,
            title,
            category,
            status,
            is_private,
            view_count,
            created_at
        FROM INQUIRY_POST
        WHERE user_idx = #{userIdx}
        ORDER BY created_at DESC
        LIMIT 10
    </select>

    <!-- =============================================
         4. 내 문의 글 총 개수 조회
         ============================================= -->
    <select id="selectMyInquiryCount" resultType="int">
        SELECT COUNT(*)
        FROM INQUIRY_POST
        WHERE user_idx = #{userIdx}
    </select>

    <!-- =============================================
         5. 내 신고 목록 조회
         - 최신순 10개
         ============================================= -->
    <select id="selectMyReportList" resultMap="ReportResultMap">
        SELECT
            report_id,
            target_type,
            target_id,
            reason,
            status,
            created_at
        FROM REPORT
        WHERE user_idx = #{userIdx}
        ORDER BY created_at DESC
        LIMIT 10
    </select>

    <!-- =============================================
         6. 내 신고 총 개수 조회
         ============================================= -->
    <select id="selectMyReportCount" resultType="int">
        SELECT COUNT(*)
        FROM REPORT
        WHERE user_idx = #{userIdx}
    </select>

    <!-- =============================================
         7. 알림 목록 조회 (최신순 10개)
         - 마이페이지 메인에서 미리보기용으로 사용
         ============================================= -->
    <select id="selectNotifications" resultMap="FeedNotificationResultMap">
        SELECT notification_id, user_idx, source_type, source_id, message, created_at
        FROM MYPAGE_FEED_NOTIFICATION
        WHERE user_idx = #{userIdx}
        ORDER BY created_at DESC
        LIMIT 10
    </select>

    <!-- =============================================
         8. 알림 총 개수 조회
         ============================================= -->
    <select id="selectNotificationCount" resultType="int">
        SELECT COUNT(*)
        FROM MYPAGE_FEED_NOTIFICATION
        WHERE user_idx = #{userIdx}
    </select>

    <!-- =============================================
         9. 알림 단건 조회
         - 알림 클릭 시 리다이렉트 URL 생성에 사용
         ============================================= -->
    <select id="selectNotification" resultMap="FeedNotificationResultMap">
        SELECT notification_id, user_idx, source_type, source_id, message, created_at
        FROM MYPAGE_FEED_NOTIFICATION
        WHERE notification_id = #{notificationId}
    </select>

    <!-- =============================================
         10. 알림 등록
         - 커뮤니티/문의/신고 모듈에서 크로스모듈로 호출됨
         ============================================= -->
    <insert id="insertNotification" useGeneratedKeys="true" keyProperty="notificationId">
        INSERT INTO MYPAGE_FEED_NOTIFICATION
        (user_idx, source_type, source_id, message, created_at)
        VALUES
        (#{userIdx}, #{sourceType}, #{sourceId}, #{message}, NOW())
    </insert>

    <!-- =============================================
         11. 알림 단건 삭제
         ============================================= -->
    <delete id="deleteNotification">
        DELETE FROM MYPAGE_FEED_NOTIFICATION
        WHERE notification_id = #{notificationId}
    </delete>

    <!-- =============================================
         12. 알림 전체 목록 조회 (무제한)
         - 더보기 클릭 시 전체 알림을 불러올 때 사용
         ============================================= -->
    <select id="selectAllNotifications" resultMap="FeedNotificationResultMap">
        SELECT notification_id, user_idx, source_type, source_id, message, created_at
        FROM MYPAGE_FEED_NOTIFICATION
        WHERE user_idx = #{userIdx}
        ORDER BY created_at DESC
    </select>

    <!-- =============================================
         13. 알림 전체 삭제
         ============================================= -->
    <delete id="deleteAllNotifications">
        DELETE FROM MYPAGE_FEED_NOTIFICATION
        WHERE user_idx = #{userIdx}
    </delete>

</mapper>
