<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
    =============================================
    MyPageMapper.xml - 마이페이지 SQL 쿼리 모음
    =============================================
-->
<mapper namespace="org.triptogether.myPage.mapper.MyPageMapper">

    <!-- 커뮤니티 매핑 -->
    <resultMap id="CommunityResultMap" type="org.triptogether.myPage.vo.MyPageCommunityDto">
        <id     property="postId"       column="post_id"/>
        <result property="title"        column="title"/>
        <result property="postType"     column="post_type"/>
        <result property="region"       column="region"/>
        <result property="commentCount" column="comment_count"/>
        <result property="likeCount"    column="like_count"/>
        <result property="viewCount"    column="view_count"/>
        <result property="postStatus"   column="post_status"/>
        <result property="createdAt"    column="created_at"/>
    </resultMap>

    <!-- 문의 매핑 -->
    <resultMap id="InquiryResultMap" type="org.triptogether.myPage.vo.MyPageInquiryDto">
        <id     property="inquiryId" column="inquiry_id"/>
        <result property="title"     column="title"/>
        <result property="category"  column="category"/>
        <result property="status"    column="status"/>
        <result property="isPrivate" column="is_private"/>
        <result property="viewCount" column="view_count"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <!-- 신고 매핑 -->
    <resultMap id="ReportResultMap" type="org.triptogether.myPage.vo.MyPageReportDto">
        <id     property="reportId"   column="report_id"/>
        <result property="targetType" column="target_type"/>
        <result property="targetId"   column="target_id"/>
        <result property="reason"     column="reason"/>
        <result property="status"     column="status"/>
        <result property="createdAt"  column="created_at"/>
    </resultMap>

    <!-- 알림 매핑 -->
    <resultMap id="FeedNotificationResultMap" type="org.triptogether.myPage.vo.FeedNotificationDto">
        <id     property="notificationId" column="notification_id"/>
        <result property="userIdx"        column="user_idx"/>
        <result property="sourceType"     column="source_type"/>
        <result property="sourceId"       column="source_id"/>
        <result property="message"        column="message"/>
        <result property="targetUrl"      column="target_url"/>
        <result property="createdAt"      column="created_at"/>
        <result property="isRead"         column="is_read"/>
    </resultMap>

    <!-- 기업 회원 신청 매핑 -->
    <resultMap id="BusinessApplicationResultMap" type="org.triptogether.admin.vo.BusinessAccountApplicationVO">
        <id     property="applicationIdx"     column="application_idx"/>
        <result property="userIdx"            column="user_idx"/>
        <result property="requestedRole"      column="requested_role"/>
        <result property="companyName"        column="company_name"/>
        <result property="businessNumber"     column="business_number"/>
        <result property="managerName"        column="manager_name"/>
        <result property="managerPhone"       column="manager_phone"/>
        <result property="description"        column="description"/>
        <result property="applicationStatus"  column="application_status"/>
        <result property="rejectReason"       column="reject_reason"/>
        <result property="reviewedByUserIdx"  column="reviewed_by_user_idx"/>
        <result property="reviewedAt"         column="reviewed_at"/>
        <result property="createdAt"          column="created_at"/>
        <result property="updatedAt"          column="updated_at"/>
    </resultMap>

    <!-- =============================================
         1. 내 커뮤니티 글 목록 조회
         - ACTIVE 상태 글만, 최신순 10개
         ============================================= -->
    <select id="selectMyCommunityList" resultMap="CommunityResultMap">
        SELECT
            post_id,
            title,
            post_type,
            region,
            comment_count,
            like_count,
            view_count,
            post_status,
            created_at
        FROM COMMUNITY_POST
        WHERE user_idx   = #{userIdx}
          AND post_status = 'ACTIVE'
        ORDER BY created_at DESC
        LIMIT 10
    </select>

    <!-- =============================================
         2. 내 커뮤니티 글 총 개수 조회
         ============================================= -->
    <select id="selectMyCommunityCount" resultType="int">
        SELECT COUNT(*)
        FROM COMMUNITY_POST
        WHERE user_idx   = #{userIdx}
          AND post_status = 'ACTIVE'
    </select>

    <!-- =============================================
         3. 내 문의 글 목록 조회
         - 최신순 10개
         ============================================= -->
    <select id="selectMyInquiryList" resultMap="InquiryResultMap">
        SELECT
            inquiry_id,
            title,
            category,
            status,
            is_private,
            view_count,
            created_at
        FROM INQUIRY_POST
        WHERE user_idx = #{userIdx}
        ORDER BY created_at DESC
        LIMIT 10
    </select>

    <!-- =============================================
         4. 내 문의 글 총 개수 조회
         ============================================= -->
    <select id="selectMyInquiryCount" resultType="int">
        SELECT COUNT(*)
        FROM INQUIRY_POST
        WHERE user_idx = #{userIdx}
    </select>

    <!-- =============================================
         5. 내 신고 목록 조회
         - 최신순 10개
         ============================================= -->
    <select id="selectMyReportList" resultMap="ReportResultMap">
        SELECT
            report_id,
            target_type,
            target_id,
            reason,
            status,
            created_at
        FROM REPORT
        WHERE user_idx = #{userIdx}
        ORDER BY created_at DESC
        LIMIT 10
    </select>

    <!-- =============================================
         6. 내 신고 총 개수 조회
         ============================================= -->
    <select id="selectMyReportCount" resultType="int">
        SELECT COUNT(*)
        FROM REPORT
        WHERE user_idx = #{userIdx}
    </select>

    <!-- =============================================
         7. 알림 목록 조회 (최신순 10개)
         - 마이페이지 메인에서 미리보기용으로 사용
         ============================================= -->
    <select id="selectNotifications" resultMap="FeedNotificationResultMap">
        SELECT notification_id, user_idx, source_type, source_id, message, target_url, created_at, is_read
        FROM MYPAGE_FEED_NOTIFICATION
        WHERE user_idx = #{userIdx}
        ORDER BY created_at DESC
        LIMIT 10
    </select>

    <!-- =============================================
         7-1. 헤더 드롭다운용 최근 N개 알림 조회
         - 안읽음 우선, 그 다음 최신순
         ============================================= -->
    <select id="selectRecentNotifications" resultMap="FeedNotificationResultMap">
        SELECT notification_id, user_idx, source_type, source_id, message, target_url, created_at, is_read
        FROM MYPAGE_FEED_NOTIFICATION
        WHERE user_idx = #{userIdx}
        ORDER BY is_read ASC, created_at DESC
        LIMIT #{limit}
    </select>

    <!-- =============================================
         8. 알림 총 개수 조회
         ============================================= -->
    <select id="selectNotificationCount" resultType="int">
        SELECT COUNT(*)
        FROM MYPAGE_FEED_NOTIFICATION
        WHERE user_idx = #{userIdx}
    </select>

    <!-- =============================================
         8-1. 안읽은 알림 개수 조회 (배지용)
         ============================================= -->
    <select id="selectUnreadCount" resultType="int">
        SELECT COUNT(*)
        FROM MYPAGE_FEED_NOTIFICATION
        WHERE user_idx = #{userIdx}
          AND is_read = 0
    </select>

    <!-- =============================================
         9. 알림 단건 조회
         - 알림 클릭 시 리다이렉트 URL 생성에 사용
         ============================================= -->
    <select id="selectNotification" resultMap="FeedNotificationResultMap">
        SELECT notification_id, user_idx, source_type, source_id, message, target_url, created_at, is_read
        FROM MYPAGE_FEED_NOTIFICATION
        WHERE notification_id = #{notificationId}
    </select>

    <!-- =============================================
         10. 알림 등록
         - 커뮤니티/문의/신고 모듈에서 크로스모듈로 호출됨
         ============================================= -->
    <insert id="insertNotification" useGeneratedKeys="true" keyProperty="notificationId">
        INSERT INTO MYPAGE_FEED_NOTIFICATION
        (user_idx, source_type, source_id, message, target_url, created_at)
        VALUES
        (#{userIdx}, #{sourceType}, #{sourceId}, #{message}, #{targetUrl}, NOW())
    </insert>

    <!-- =============================================
         10-1. 알림 단건 읽음 처리
         ============================================= -->
    <update id="updateRead">
        UPDATE MYPAGE_FEED_NOTIFICATION
           SET is_read = 1
         WHERE notification_id = #{notificationId}
    </update>

    <!-- =============================================
         10-2. 알림 전체 읽음 처리
         ============================================= -->
    <update id="updateReadAll">
        UPDATE MYPAGE_FEED_NOTIFICATION
           SET is_read = 1
         WHERE user_idx = #{userIdx}
           AND is_read = 0
    </update>

    <!-- =============================================
         11. 알림 단건 삭제
         ============================================= -->
    <delete id="deleteNotification">
        DELETE FROM MYPAGE_FEED_NOTIFICATION
        WHERE notification_id = #{notificationId}
    </delete>

    <!-- =============================================
         12. 알림 전체 목록 조회 (무제한)
         - 더보기 클릭 시 전체 알림을 불러올 때 사용
         ============================================= -->
    <select id="selectAllNotifications" resultMap="FeedNotificationResultMap">
        SELECT notification_id, user_idx, source_type, source_id, message, target_url, created_at, is_read
        FROM MYPAGE_FEED_NOTIFICATION
        WHERE user_idx = #{userIdx}
        ORDER BY created_at DESC
    </select>

    <!-- =============================================
         13. 알림 전체 삭제
         ============================================= -->
    <delete id="deleteAllNotifications">
        DELETE FROM MYPAGE_FEED_NOTIFICATION
        WHERE user_idx = #{userIdx}
    </delete>

    <!-- 리뷰 매핑 -->
    <resultMap id="ReviewResultMap" type="org.triptogether.myPage.vo.MyPageReviewDto">
        <id     property="reviewIdx" column="review_idx"/>
        <result property="spotIdx"   column="spot_idx"/>
        <result property="spotName"  column="spot_name"/>
        <result property="rating"    column="rating"/>
        <result property="content"   column="content"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <!-- 여행 일정 매핑 -->
    <resultMap id="PlanResultMap" type="org.triptogether.myPage.vo.MyPagePlanDto">
        <id     property="planId"      column="plan_id"/>
        <result property="title"       column="title"/>
        <result property="destination" column="destination"/>
        <result property="startDate"   column="start_date"/>
        <result property="endDate"     column="end_date"/>
        <result property="isPublic"    column="is_public"/>
        <result property="planSource"  column="plan_source"/>
        <result property="createdAt"   column="created_at"/>
    </resultMap>

    <resultMap id="LevelRewardResultMap" type="org.triptogether.myPage.vo.MyPageLevelRewardDto">
        <id     property="levelUpRewardPolicyIdx" column="level_up_reward_policy_idx"/>
        <result property="levelNo"                column="level_no"/>
        <result property="rewardType"             column="reward_type"/>
        <result property="rewardAmount"           column="reward_amount"/>
        <result property="itemCode"               column="item_code"/>
        <result property="itemName"               column="item_name"/>
        <result property="claimed"                column="claimed"/>
    </resultMap>

    <!-- 항공권 예매 매핑 -->
    <resultMap id="FlightBookingResultMap" type="org.triptogether.myPage.vo.MyPageFlightBookingDto">
        <id     property="flightPurchaseIdx"    column="flight_purchase_idx"/>
        <result property="paymentIdx"           column="payment_idx"/>
        <result property="purchaseNo"           column="purchase_no"/>
        <result property="spotIdx"              column="spot_idx"/>
        <result property="spotName"             column="spot_name"/>
        <result property="airlineName"          column="airline_name"/>
        <result property="flightNo"             column="flight_no"/>
        <result property="originAirportCode"    column="origin_airport_code"/>
        <result property="destinationAirportCode" column="destination_airport_code"/>
        <result property="departureTime"        column="departure_time"/>
        <result property="arrivalTime"          column="arrival_time"/>
        <result property="tripType"             column="trip_type"/>
        <result property="returnAirlineName"    column="return_airline_name"/>
        <result property="returnFlightNo"       column="return_flight_no"/>
        <result property="returnOriginAirportCode" column="return_origin_airport_code"/>
        <result property="returnDestinationAirportCode" column="return_destination_airport_code"/>
        <result property="returnDepartureTime"  column="return_departure_time"/>
        <result property="returnArrivalTime"    column="return_arrival_time"/>
        <result property="outboundPrice"        column="outbound_price"/>
        <result property="returnPrice"          column="return_price"/>
        <result property="totalPrice"           column="total_price"/>
        <result property="usedCash"             column="used_cash"/>
        <result property="usedMileage"          column="used_mileage"/>
        <result property="originalAmount"       column="original_amount"/>
        <result property="discountRate"         column="discount_rate"/>
        <result property="discountAmount"       column="discount_amount"/>
        <result property="finalAmount"          column="final_amount"/>
        <result property="paymentStatus"        column="payment_status"/>
        <result property="paidAt"               column="paid_at"/>
        <result property="status"               column="status"/>
        <result property="cancelReason"         column="cancel_reason"/>
        <result property="createdAt"            column="created_at"/>
    </resultMap>

    <!-- 패키지 예약 매핑 -->
    <resultMap id="PackageBookingResultMap" type="org.triptogether.myPage.vo.MyPagePackageBookingDto">
        <id     property="packageBookingIdx" column="package_booking_idx"/>
        <result property="bookingNo"         column="booking_no"/>
        <result property="packageIdx"        column="package_idx"/>
        <result property="spotIdx"           column="spot_idx"/>
        <result property="spotName"          column="spot_name"/>
        <result property="packageTitle"      column="package_title"/>
        <result property="packageSummary"    column="package_summary"/>
        <result property="mainImagePath"     column="main_image_path"/>
        <result property="sellerNickname"    column="seller_nickname"/>
        <result property="startDate"         column="start_date"/>
        <result property="endDate"           column="end_date"/>
        <result property="peopleCount"       column="people_count"/>
        <result property="unitPrice"         column="unit_price"/>
        <result property="totalPrice"        column="total_price"/>
        <result property="usedCash"          column="used_cash"/>
        <result property="usedMileage"       column="used_mileage"/>
        <result property="bookingStatus"     column="booking_status"/>
        <result property="bookedAt"          column="booked_at"/>
        <result property="cancelledAt"       column="cancelled_at"/>
        <result property="cancelReason"      column="cancel_reason"/>
    </resultMap>

    <!-- =============================================
         14. 내 리뷰 목록 조회
         - 차단되지 않은 리뷰만, 최신순 5개
         ============================================= -->
    <select id="selectMyReviewList" resultMap="ReviewResultMap">
        SELECT
            sr.review_idx,
            sr.spot_idx,
            st.name AS spot_name,
            sr.rating,
            sr.content,
            sr.created_at
        FROM SPOT_REVIEW sr
        JOIN SPOT_TRAVEL st ON sr.spot_idx = st.spot_idx
        WHERE sr.user_idx    = #{userIdx}
          AND sr.review_block = 0
        ORDER BY sr.created_at DESC
        LIMIT 5
    </select>

    <!-- =============================================
         15. 내 리뷰 총 개수 조회
         ============================================= -->
    <select id="selectMyReviewCount" resultType="int">
        SELECT COUNT(*)
        FROM SPOT_REVIEW
        WHERE user_idx    = #{userIdx}
          AND review_block = 0
    </select>

    <!-- =============================================
         16. 내 여행 일정 목록 조회
         - 최신순 5개
         ============================================= -->
    <select id="selectMyPlanList" resultMap="PlanResultMap">
        SELECT
            plan_id,
            title,
            destination,
            start_date,
            end_date,
            is_public,
            plan_source,
            created_at
        FROM TRAVEL_PLAN
        WHERE user_idx = #{userIdx}
        ORDER BY created_at DESC
        LIMIT 5
    </select>

    <!-- =============================================
         17. 내 여행 일정 총 개수 조회
         ============================================= -->
    <select id="selectMyPlanCount" resultType="int">
        SELECT COUNT(*)
        FROM TRAVEL_PLAN
        WHERE user_idx = #{userIdx}
    </select>

    <select id="selectMyLevelRewardList" resultMap="LevelRewardResultMap">
        SELECT
            lurp.level_up_reward_policy_idx,
            lurp.level_no,
            lurp.reward_type,
            lurp.reward_amount,
            lurp.item_code,
            psi.item_name,
            CASE
                WHEN ulurh.user_level_up_reward_history_idx IS NOT NULL THEN 1
                ELSE 0
            END AS claimed
        FROM LEVEL_UP_REWARD_POLICY lurp
        LEFT JOIN POINT_SHOP_ITEM psi
               ON lurp.item_code = psi.item_code
        LEFT JOIN USER_LEVEL_UP_REWARD_HISTORY ulurh
               ON ulurh.level_up_reward_policy_idx = lurp.level_up_reward_policy_idx
              AND ulurh.user_idx = #{userIdx}
              AND ulurh.grant_status = 'GRANTED'
        WHERE lurp.is_active = 1
        ORDER BY lurp.level_no ASC, lurp.sort_order ASC, lurp.priority ASC, lurp.level_up_reward_policy_idx ASC
    </select>

    <!-- =============================================
         18. 내 항공권 예매 목록 조회
         - 최신순 5개
         ============================================= -->
    <select id="selectMyFlightBookingList" resultMap="FlightBookingResultMap">
        SELECT
            fps.flight_purchase_idx,
            fps.payment_idx,
            fps.purchase_no,
            fps.spot_idx,
            st.name AS spot_name,
            fps.airline_name,
            fps.flight_no,
            fps.origin_airport_code,
            fps.destination_airport_code,
            fps.departure_time,
            fps.arrival_time,
            fps.trip_type,
            fps.return_airline_name,
            fps.return_flight_no,
            fps.return_origin_airport_code,
            fps.return_destination_airport_code,
            fps.return_departure_time,
            fps.return_arrival_time,
            fps.outbound_price,
            fps.return_price,
            fps.total_price,
            fps.used_cash,
            fps.used_mileage,
            COALESCE(uph.original_amount, fps.outbound_price + fps.return_price, fps.total_price) AS original_amount,
            COALESCE(uph.discount_rate, 0) AS discount_rate,
            COALESCE(uph.discount_amount, 0) AS discount_amount,
            COALESCE(uph.final_amount, fps.total_price) AS final_amount,
            uph.payment_status,
            uph.paid_at,
            fps.status,
            fps.cancel_reason,
            fps.created_at
        FROM FLIGHT_PURCHASE_SIMULATION fps
        LEFT JOIN SPOT_TRAVEL st ON fps.spot_idx = st.spot_idx
        LEFT JOIN USER_PAYMENT_HISTORY uph ON fps.payment_idx = uph.payment_idx
        WHERE fps.user_idx = #{userIdx}
        ORDER BY fps.created_at DESC
        LIMIT 5
    </select>

    <!-- =============================================
         19. 내 항공권 예매 총 개수 조회
         ============================================= -->
    <select id="selectMyFlightBookingCount" resultType="int">
        SELECT COUNT(*)
        FROM FLIGHT_PURCHASE_SIMULATION
        WHERE user_idx = #{userIdx}
    </select>

    <!-- =============================================
         20. 내 항공권 예매 전체 목록 조회
         ============================================= -->
    <select id="selectMyFlightBookingAllList" resultMap="FlightBookingResultMap">
        SELECT
            fps.flight_purchase_idx,
            fps.payment_idx,
            fps.purchase_no,
            fps.spot_idx,
            st.name AS spot_name,
            fps.airline_name,
            fps.flight_no,
            fps.origin_airport_code,
            fps.destination_airport_code,
            fps.departure_time,
            fps.arrival_time,
            fps.trip_type,
            fps.return_airline_name,
            fps.return_flight_no,
            fps.return_origin_airport_code,
            fps.return_destination_airport_code,
            fps.return_departure_time,
            fps.return_arrival_time,
            fps.outbound_price,
            fps.return_price,
            fps.total_price,
            fps.used_cash,
            fps.used_mileage,
            COALESCE(uph.original_amount, fps.outbound_price + fps.return_price, fps.total_price) AS original_amount,
            COALESCE(uph.discount_rate, 0) AS discount_rate,
            COALESCE(uph.discount_amount, 0) AS discount_amount,
            COALESCE(uph.final_amount, fps.total_price) AS final_amount,
            uph.payment_status,
            uph.paid_at,
            fps.status,
            fps.cancel_reason,
            fps.created_at
        FROM FLIGHT_PURCHASE_SIMULATION fps
        LEFT JOIN SPOT_TRAVEL st ON fps.spot_idx = st.spot_idx
        LEFT JOIN USER_PAYMENT_HISTORY uph ON fps.payment_idx = uph.payment_idx
        WHERE fps.user_idx = #{userIdx}
        ORDER BY fps.created_at DESC
    </select>

    <!-- =============================================
         21. 내 패키지 예약 목록 조회
         - 최신순 5개
         ============================================= -->
    <select id="selectMyPackageBookingList" resultMap="PackageBookingResultMap">
        SELECT
            tpb.package_booking_idx,
            tpb.booking_no,
            tpb.package_idx,
            tp.spot_idx,
            st.name AS spot_name,
            tp.package_title,
            tp.package_summary,
            tp.main_image_path,
            seller.nickname AS seller_nickname,
            tp.start_date,
            tp.end_date,
            tpb.people_count,
            tpb.unit_price,
            tpb.total_price,
            tpb.used_cash,
            tpb.used_mileage,
            tpb.booking_status,
            tpb.booked_at,
            tpb.cancelled_at,
            tpb.cancel_reason
        FROM TRAVEL_PACKAGE_BOOKING tpb
        JOIN TRAVEL_PACKAGE tp ON tpb.package_idx = tp.package_idx
        LEFT JOIN SPOT_TRAVEL st ON tp.spot_idx = st.spot_idx
        LEFT JOIN USERS seller ON tp.seller_user_idx = seller.user_idx
        WHERE tpb.user_idx = #{userIdx}
        ORDER BY tpb.booked_at DESC
        LIMIT 5
    </select>

    <!-- =============================================
         21. 내 패키지 예약 총 개수 조회
         ============================================= -->
    <select id="selectMyPackageBookingCount" resultType="int">
        SELECT COUNT(*)
        FROM TRAVEL_PACKAGE_BOOKING
        WHERE user_idx = #{userIdx}
    </select>

    <!-- =============================================
         23. 내 패키지 예약 전체 목록 조회
         ============================================= -->
    <select id="selectMyPackageBookingAllList" resultMap="PackageBookingResultMap">
        SELECT
            tpb.package_booking_idx,
            tpb.booking_no,
            tpb.package_idx,
            tp.spot_idx,
            st.name AS spot_name,
            tp.package_title,
            tp.package_summary,
            tp.main_image_path,
            seller.nickname AS seller_nickname,
            tp.start_date,
            tp.end_date,
            tpb.people_count,
            tpb.unit_price,
            tpb.total_price,
            tpb.used_cash,
            tpb.used_mileage,
            tpb.booking_status,
            tpb.booked_at,
            tpb.cancelled_at,
            tpb.cancel_reason
        FROM TRAVEL_PACKAGE_BOOKING tpb
        JOIN TRAVEL_PACKAGE tp ON tpb.package_idx = tp.package_idx
        LEFT JOIN SPOT_TRAVEL st ON tp.spot_idx = st.spot_idx
        LEFT JOIN USERS seller ON tp.seller_user_idx = seller.user_idx
        WHERE tpb.user_idx = #{userIdx}
        ORDER BY tpb.booked_at DESC
    </select>

    <!-- =============================================
         24. 내 기업 회원 신청 최신 건 조회
         ============================================= -->
    <select id="selectLatestBusinessApplication" resultMap="BusinessApplicationResultMap">
        SELECT
            application_idx,
            user_idx,
            requested_role,
            company_name,
            business_number,
            manager_name,
            manager_phone,
            description,
            application_status,
            reject_reason,
            reviewed_by_user_idx,
            reviewed_at,
            created_at,
            updated_at
        FROM BUSINESS_ACCOUNT_APPLICATION
        WHERE user_idx = #{userIdx}
        ORDER BY created_at DESC
        LIMIT 1
    </select>

    <!-- =============================================
         21. 검토 대기 중인 기업 회원 신청 개수
         ============================================= -->
    <select id="countPendingBusinessApplication" resultType="int">
        SELECT COUNT(*)
        FROM BUSINESS_ACCOUNT_APPLICATION
        WHERE user_idx = #{userIdx}
          AND application_status = 'PENDING'
    </select>

    <!-- =============================================
         22. 기업 회원 신청 등록
         ============================================= -->
    <insert id="insertBusinessApplication" parameterType="org.triptogether.admin.vo.BusinessAccountApplicationVO">
        INSERT INTO BUSINESS_ACCOUNT_APPLICATION (
            user_idx,
            requested_role,
            company_name,
            business_number,
            manager_name,
            manager_phone,
            description,
            application_status
        ) VALUES (
            #{userIdx},
            #{requestedRole},
            #{companyName},
            #{businessNumber},
            #{managerName},
            #{managerPhone},
            #{description},
            'PENDING'
        )
    </insert>

</mapper>
