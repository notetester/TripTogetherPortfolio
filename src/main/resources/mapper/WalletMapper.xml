<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.triptogether.myPage.mapper.WalletMapper">

    <resultMap id="WalletUserMap" type="org.triptogether.auth.vo.UsersVO">
        <id property="userIdx" column="user_idx"/>
        <result property="userId" column="user_id"/>
        <result property="userEmail" column="user_email"/>
        <result property="userPassword" column="user_password"/>
        <result property="passwordEnabled" column="password_enabled"/>
        <result property="emailVerified" column="email_verified"/>
        <result property="emailLoginEnabled" column="email_login_enabled"/>
        <result property="accountStatus" column="account_status"/>
        <result property="userRole" column="user_role"/>
        <result property="memberGrade" column="member_grade"/>
        <result property="verifiedMember" column="is_verified_member"/>
        <result property="cashBalance" column="cash_balance"/>
        <result property="mileageBalance" column="mileage_balance"/>
        <result property="pointBalance" column="point_balance"/>
        <result property="levelNo" column="level_no"/>
        <result property="expPoints" column="exp_points"/>
        <result property="totalPostCount" column="total_post_count"/>
        <result property="totalCommentCount" column="total_comment_count"/>
        <result property="lastLoginAt" column="last_login_at"/>
        <result property="dormantAt" column="dormant_at"/>
        <result property="dormantReleaseRequired" column="dormant_release_required"/>
        <result property="blockedUntil" column="blocked_until"/>
        <result property="blockedReason" column="blocked_reason"/>
        <result property="adminPositionCode" column="admin_position_code"/>
        <result property="adminPermissionCode" column="admin_permission_code"/>
        <result property="statusChangedAt" column="status_changed_at"/>
        <result property="nickname" column="nickname"/>
        <result property="nationality" column="nationality"/>
        <result property="preferredLang" column="preferred_lang"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <resultMap id="WalletPaymentMap" type="org.triptogether.myPage.vo.WalletPaymentDto">
        <id property="paymentIdx" column="payment_idx"/>
        <result property="userIdx" column="user_idx"/>
        <result property="paymentType" column="payment_type"/>
        <result property="paymentMethod" column="payment_method"/>
        <result property="orderName" column="order_name"/>
        <result property="sourceType" column="source_type"/>
        <result property="sourceId" column="source_id"/>
        <result property="originalAmount" column="original_amount"/>
        <result property="discountRate" column="discount_rate"/>
        <result property="discountAmount" column="discount_amount"/>
        <result property="finalAmount" column="final_amount"/>
        <result property="usedCash" column="used_cash"/>
        <result property="usedMileage" column="used_mileage"/>
        <result property="earnedMileage" column="earned_mileage"/>
        <result property="paymentStatus" column="payment_status"/>
        <result property="paidAt" column="paid_at"/>
        <result property="cancelledAt" column="cancelled_at"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <resultMap id="WalletHistoryMap" type="org.triptogether.myPage.vo.WalletHistoryDto">
        <id property="walletHistoryIdx" column="wallet_history_idx"/>
        <result property="userIdx" column="user_idx"/>
        <result property="assetType" column="asset_type"/>
        <result property="changeType" column="change_type"/>
        <result property="amount" column="amount"/>
        <result property="balanceAfter" column="balance_after"/>
        <result property="relatedPaymentIdx" column="related_payment_idx"/>
        <result property="detailMessage" column="detail_message"/>
        <result property="actorUserIdx" column="actor_user_idx"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="selectUserByIdx" resultMap="WalletUserMap">
        SELECT *
        FROM USERS
        WHERE user_idx = #{userIdx}
    </select>

    <select id="selectUserByIdxForUpdate" resultMap="WalletUserMap">
        SELECT *
        FROM USERS
        WHERE user_idx = #{userIdx}
        FOR UPDATE
    </select>

    <update id="updateWalletBalances">
        UPDATE USERS
        SET cash_balance = #{cashBalance},
            mileage_balance = #{mileageBalance}
        WHERE user_idx = #{userIdx}
    </update>

    <insert id="insertPaymentHistory" useGeneratedKeys="true" keyProperty="paymentIdx" keyColumn="payment_idx">
        INSERT INTO USER_PAYMENT_HISTORY (
            user_idx, payment_type, payment_method, order_name, source_type, source_id,
            original_amount, discount_rate, discount_amount, final_amount,
            used_cash, used_mileage, earned_mileage, payment_status, paid_at, created_at
        ) VALUES (
            #{userIdx}, #{paymentType}, #{paymentMethod}, #{orderName}, #{sourceType}, #{sourceId},
            #{originalAmount}, #{discountRate}, #{discountAmount}, #{finalAmount},
            #{usedCash}, #{usedMileage}, #{earnedMileage}, #{paymentStatus}, NOW(), NOW()
        )
    </insert>

    <insert id="insertWalletHistory">
        INSERT INTO USER_WALLET_HISTORY (
            user_idx, asset_type, change_type, amount, balance_after,
            related_payment_idx, detail_message, actor_user_idx, created_at
        ) VALUES (
            #{userIdx}, #{assetType}, #{changeType}, #{amount}, #{balanceAfter},
            #{relatedPaymentIdx}, #{detailMessage}, #{actorUserIdx}, NOW()
        )
    </insert>

    <select id="selectRecentPaymentHistory" resultMap="WalletPaymentMap">
        SELECT *
        FROM USER_PAYMENT_HISTORY
        WHERE user_idx = #{userIdx}
        ORDER BY created_at DESC
        LIMIT 12
    </select>

    <select id="selectRecentWalletHistory" resultMap="WalletHistoryMap">
        SELECT *
        FROM USER_WALLET_HISTORY
        WHERE user_idx = #{userIdx}
        ORDER BY created_at DESC
        LIMIT 20
    </select>

</mapper>
