<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
    =============================================
    InquiryMapper.xml - 문의 게시판 SQL 쿼리 모음
    =============================================
-->
<mapper namespace="org.triptogether.inquiry.mapper.InquiryMapper">

    <!-- 문의 게시글 매핑 -->
    <resultMap id="InquiryResultMap" type="org.triptogether.inquiry.vo.InquiryPostDto">
        <id     property="inquiryId"  column="inquiry_id"/>
        <result property="userIdx"    column="user_idx"/>
        <result property="nickname"   column="nickname"/>
        <result property="title"      column="title"/>
        <result property="content"    column="content"/>
        <result property="category"   column="category"/>
        <result property="isPrivate"  column="is_private"/>
        <result property="status"     column="status"/>
        <result property="viewCount"  column="view_count"/>
        <result property="createdAt"  column="created_at"/>
        <result property="updatedAt"  column="updated_at"/>
        <result property="inProgressAt"          column="in_progress_at"/>
        <result property="completedAt"           column="completed_at"/>
        <result property="cancelledAt"           column="cancelled_at"/>
        <result property="deleteRequestedAt"     column="delete_requested_at"/>
        <result property="visibilityRequestedAt" column="visibility_requested_at"/>
    </resultMap>

    <!-- 답변 매핑 -->
    <resultMap id="AnswerResultMap" type="org.triptogether.inquiry.vo.InquiryAnswerDto">
        <id     property="answerId"      column="answer_id"/>
        <result property="inquiryId"     column="inquiry_id"/>
        <result property="adminUserIdx"  column="admin_user_idx"/>
        <result property="adminNickname" column="nickname"/>
        <result property="content"       column="content"/>
        <result property="createdAt"     column="created_at"/>
        <result property="updatedAt"     column="updated_at"/>
    </resultMap>

    <!-- 첨부파일 매핑 -->
    <resultMap id="AttachmentResultMap" type="org.triptogether.inquiry.vo.InquiryAttachmentDto">
        <id     property="attachmentId" column="attachment_id"/>
        <result property="inquiryId"    column="inquiry_id"/>
        <result property="fileUrl"      column="file_url"/>
        <result property="fileName"     column="file_name"/>
        <result property="createdAt"    column="created_at"/>
    </resultMap>

    <!-- =============================================
         1. 목록 조회
         - 검색 조건(카테고리, 상태, 키워드)에 맞는 문의 목록 반환
         - 키워드는 제목, 내용, 답변 내용까지 검색
         - 최신순 정렬, 페이지네이션 적용
         ============================================= -->
    <select id="selectInquiryList" resultMap="InquiryResultMap">
        SELECT
        ip.inquiry_id,
        ip.user_idx,
        u.nickname,
        ip.title,
        ip.category,
        ip.is_private,
        ip.status,
        ip.view_count,
        ip.created_at,
        ip.updated_at
        FROM INQUIRY_POST ip
        LEFT JOIN USERS u ON ip.user_idx = u.user_idx
        <where>
            <!-- 카테고리 필터 -->
            <if test="category != null and category != ''">
                AND ip.category = #{category}
            </if>
            <!-- 상태 필터 (PENDING/IN_PROGRESS/COMPLETED) -->
            <if test="status != null and status != ''">
                AND ip.status = #{status}
            </if>
            <!-- 본인 글만 보기 -->
            <if test="userIdx != null">
                AND ip.user_idx = #{userIdx}
            </if>
            <!-- 키워드 검색 (제목 + 내용 + 답변 내용) -->
            <if test="keyword != null and keyword != ''">
                AND (ip.title   LIKE CONCAT('%', #{keyword}, '%')
                OR ip.content LIKE CONCAT('%', #{keyword}, '%')
                OR EXISTS (
                SELECT 1 FROM INQUIRY_ANSWER ia
                WHERE ia.inquiry_id = ip.inquiry_id
                AND ia.content LIKE CONCAT('%', #{keyword}, '%')
                ))
            </if>
        </where>
        ORDER BY ip.created_at DESC
        LIMIT #{pageSize} OFFSET #{offset}
    </select>

    <!-- =============================================
         2. 전체 개수 조회
         - 페이지네이션 계산에 사용
         - 목록 조회와 동일한 검색 조건 적용
         ============================================= -->
    <select id="selectTotalCount" resultType="int">
        SELECT COUNT(*)
        FROM INQUIRY_POST ip
        <where>
            <if test="category != null and category != ''">
                AND ip.category = #{category}
            </if>
            <if test="status != null and status != ''">
                AND ip.status = #{status}
            </if>
            <if test="userIdx != null">
                AND ip.user_idx = #{userIdx}
            </if>
            <if test="keyword != null and keyword != ''">
                AND (ip.title   LIKE CONCAT('%', #{keyword}, '%')
                OR ip.content LIKE CONCAT('%', #{keyword}, '%')
                OR EXISTS (
                SELECT 1 FROM INQUIRY_ANSWER ia
                WHERE ia.inquiry_id = ip.inquiry_id
                AND ia.content LIKE CONCAT('%', #{keyword}, '%')
                ))
            </if>
        </where>
    </select>

    <!-- =============================================
         3. 문의 상세 조회
         - inquiryId로 단건 문의 조회
         - USERS 테이블 JOIN으로 닉네임 함께 조회
         ============================================= -->
    <select id="selectInquiry" resultMap="InquiryResultMap">
        SELECT
        ip.inquiry_id,
        ip.user_idx,
        u.nickname,
        ip.title,
        ip.content,
        ip.category,
        ip.is_private,
        ip.status,
        ip.view_count,
        ip.created_at,
        ip.updated_at,
        ip.in_progress_at,
        ip.completed_at,
        ip.cancelled_at,
        ip.delete_requested_at,
        ip.visibility_requested_at
        FROM INQUIRY_POST ip
        LEFT JOIN USERS u ON ip.user_idx = u.user_idx
        WHERE ip.inquiry_id = #{inquiryId}
    </select>

    <!-- =============================================
         4. 답변 조회
         - 해당 문의에 달린 운영진 답변 조회
         - USERS 테이블 JOIN으로 운영진 닉네임 함께 조회
         - 답변이 없으면 null 반환
         ============================================= -->
    <select id="selectAnswer" resultMap="AnswerResultMap">
        SELECT
        ia.answer_id,
        ia.inquiry_id,
        ia.admin_user_idx,
        u.nickname,
        ia.content,
        ia.created_at,
        ia.updated_at
        FROM INQUIRY_ANSWER ia
        LEFT JOIN USERS u ON ia.admin_user_idx = u.user_idx
        WHERE ia.inquiry_id = #{inquiryId}
    </select>

    <!-- =============================================
         5. 조회수 증가
         - 상세 페이지 진입 시 호출
         ============================================= -->
    <update id="updateViewCount">
        UPDATE INQUIRY_POST
        SET view_count = view_count + 1
        WHERE inquiry_id = #{inquiryId}
    </update>

    <!-- =============================================
         6. 문의 등록
         - 새 문의를 DB에 저장
         - useGeneratedKeys: 자동 생성된 PK를 inquiryId에 넣어줌
         - 기본 상태는 PENDING(대기중)으로 시작
         ============================================= -->
    <insert id="insertInquiry" useGeneratedKeys="true" keyProperty="inquiryId">
        INSERT INTO INQUIRY_POST (user_idx, title, content, category, is_private, status, created_at, updated_at)
        VALUES (#{userIdx}, #{title}, #{content}, #{category}, #{isPrivate}, 'PENDING', NOW(), NOW())
    </insert>

    <!-- =============================================
         7. 답변 등록
         - 운영진이 문의에 답변을 저장
         - 답변 등록 후 반드시 updateStatus로 상태를 COMPLETED로 변경해야 함
           (Service에서 @Transactional로 묶어서 처리)
         ============================================= -->
    <insert id="insertAnswer" useGeneratedKeys="true" keyProperty="answerId">
        INSERT INTO INQUIRY_ANSWER (inquiry_id, admin_user_idx, content, created_at, updated_at)
        VALUES (#{inquiryId}, #{adminUserIdx}, #{content}, NOW(), NOW())
    </insert>

    <!-- =============================================
         8. 문의 상태 변경
         - status 값: PENDING(대기중) / IN_PROGRESS(처리중) / COMPLETED(완료)
         - 답변 등록 시 COMPLETED로 변경하는 데 주로 사용
         ============================================= -->
    <update id="updateStatus">
        UPDATE INQUIRY_POST
        SET status     = #{status},
        updated_at = NOW()
        WHERE inquiry_id = #{inquiryId}
    </update>

    <!-- =============================================
         9. 문의 수정
         - 제목, 내용, 카테고리, 공개여부 수정
         - PENDING 상태일 때만 가능 (Controller에서 체크)
         ============================================= -->
    <update id="updateInquiry">
        UPDATE INQUIRY_POST
        SET title      = #{title},
        content    = #{content},
        category   = #{category},
        is_private = #{isPrivate},
        updated_at = NOW()
        WHERE inquiry_id = #{inquiryId}
    </update>

    <!-- =============================================
         10. 문의 삭제
         - PENDING 상태일 때만 가능 (Controller에서 체크)
         ============================================= -->
    <delete id="deleteInquiry">
        DELETE FROM INQUIRY_POST
        WHERE inquiry_id = #{inquiryId}
    </delete>

    <!-- =============================================
         11. 공개여부 변경
         ============================================= -->
    <update id="updateIsPrivate">
        UPDATE INQUIRY_POST
        SET is_private = #{isPrivate},
            updated_at = NOW()
        WHERE inquiry_id = #{inquiryId}
    </update>

    <!-- =============================================
         12. 상태 변경 (시간 기록 포함)
         ============================================= -->
    <update id="updateStatusWithTime">
        UPDATE INQUIRY_POST
        SET status = #{status},
            in_progress_at = CASE WHEN #{status} = 'IN_PROGRESS' THEN NOW() ELSE in_progress_at END,
            completed_at = CASE WHEN #{status} IN ('COMPLETED', 'USER_COMPLETED') THEN NOW() ELSE completed_at END,
            cancelled_at = CASE WHEN #{status} = 'CANCELLED' THEN NOW() ELSE cancelled_at END,
            delete_requested_at = CASE WHEN #{status} = 'DELETE_REQUESTED' THEN NOW() ELSE delete_requested_at END,
            visibility_requested_at = CASE WHEN #{status} IN ('PRIVATE_REQUESTED', 'PUBLIC_REQUESTED') THEN NOW() ELSE visibility_requested_at END,
            updated_at = NOW()
        WHERE inquiry_id = #{inquiryId}
    </update>

    <!-- =============================================
         13. 답변 수정
         ============================================= -->
    <update id="updateAnswer">
        UPDATE INQUIRY_ANSWER
        SET content    = #{content},
            updated_at = NOW()
        WHERE inquiry_id = #{inquiryId}
    </update>

    <!-- =============================================
         14. 답변 삭제
         ============================================= -->
    <delete id="deleteAnswer">
        DELETE FROM INQUIRY_ANSWER
        WHERE inquiry_id = #{inquiryId}
    </delete>

    <!-- =============================================
         15. 첨부파일 등록
         ============================================= -->
    <insert id="insertAttachment" useGeneratedKeys="true" keyProperty="attachmentId">
        INSERT INTO INQUIRY_ATTACHMENT (inquiry_id, file_url, file_name, created_at)
        VALUES (#{inquiryId}, #{fileUrl}, #{fileName}, NOW())
    </insert>

    <!-- =============================================
         16. 첨부파일 목록 조회
         ============================================= -->
    <select id="selectAttachmentList" resultMap="AttachmentResultMap">
        SELECT attachment_id, inquiry_id, file_url, file_name, created_at
        FROM INQUIRY_ATTACHMENT
        WHERE inquiry_id = #{inquiryId}
        ORDER BY created_at ASC
    </select>

    <!-- =============================================
         17. 첨부파일 삭제
         ============================================= -->
    <delete id="deleteAttachment">
        DELETE FROM INQUIRY_ATTACHMENT
        WHERE attachment_id = #{attachmentId}
    </delete>

</mapper>