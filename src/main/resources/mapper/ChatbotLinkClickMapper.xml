<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.triptogether.common.mapper.ChatbotLinkClickMapper">

    <!-- =============================================
         1. 클릭 기록 저장
         ============================================= -->
    <insert id="insertClick" parameterType="ChatbotLinkClickVO"
            useGeneratedKeys="true" keyProperty="clickId">
        INSERT INTO CHATBOT_LINK_CLICK
            (message_id, conversation_id, user_idx, anon_session_id, url, label, ip_address)
        VALUES
            (#{messageId}, #{conversationId}, #{userIdx}, #{anonSessionId}, #{url}, #{label}, #{ipAddress})
    </insert>

</mapper>
