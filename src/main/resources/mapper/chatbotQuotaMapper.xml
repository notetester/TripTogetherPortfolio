<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.triptogether.common.mapper.ChatbotQuotaMapper">

    <resultMap id="QuotaResultMap" type="ChatbotQuotaVO">
        <id     property="quotaId"              column="quota_id"/>
        <result property="grade"                column="grade"/>
        <result property="maxConversations"     column="max_conversations"/>
        <result property="maxMessagesPerPeriod" column="max_messages_per_period"/>
        <result property="maxContextMessages"   column="max_context_messages"/>
        <result property="periodDays"           column="period_days"/>
        <result property="resetHour"            column="reset_hour"/>
        <result property="resetMinute"          column="reset_minute"/>
        <result property="quotaRefundEnabled"   column="quota_refund_enabled"/>
        <result property="updatedBy"            column="updated_by"/>
        <result property="updaterNickname"      column="updater_nickname"/>
        <result property="updatedAt"            column="updated_at"/>
    </resultMap>

    <resultMap id="UsageResultMap" type="ChatbotDailyUsageVO">
        <id     property="usageId"        column="usage_id"/>
        <result property="userIdx"        column="user_idx"/>
        <result property="ipAddress"      column="ip_address"/>
        <result property="periodStart"    column="period_start"/>
        <result property="messageCount"   column="message_count"/>
    </resultMap>

    <!-- =============================================
         1. 특정 등급 한도 조회
         ============================================= -->
    <select id="selectQuotaByGrade" resultMap="QuotaResultMap">
        SELECT quota_id, grade, max_conversations, max_messages_per_period,
               max_context_messages, period_days, reset_hour, reset_minute,
               quota_refund_enabled, updated_by, updated_at
        FROM CHATBOT_GRADE_QUOTA
        WHERE grade = #{grade}
    </select>

    <!-- =============================================
         2. 전체 등급 한도 목록 (마지막 수정자 닉네임 조인)
         ============================================= -->
    <select id="selectAllQuotas" resultMap="QuotaResultMap">
        SELECT q.quota_id, q.grade, q.max_conversations, q.max_messages_per_period,
               q.max_context_messages, q.period_days, q.reset_hour, q.reset_minute,
               q.quota_refund_enabled, q.updated_by, q.updated_at,
               u.nickname AS updater_nickname
        FROM CHATBOT_GRADE_QUOTA q
        LEFT JOIN USERS u ON u.user_idx = q.updated_by
        ORDER BY q.quota_id
    </select>

    <!-- =============================================
         3. 등급 한도 업데이트 (관리자)
         ============================================= -->
    <update id="updateQuota" parameterType="ChatbotQuotaVO">
        UPDATE CHATBOT_GRADE_QUOTA
           SET max_conversations       = #{maxConversations},
               max_messages_per_period = #{maxMessagesPerPeriod},
               max_context_messages    = #{maxContextMessages},
               period_days             = #{periodDays},
               reset_hour              = #{resetHour},
               reset_minute            = #{resetMinute},
               quota_refund_enabled    = #{quotaRefundEnabled},
               updated_by              = #{updatedBy}
         WHERE quota_id = #{quotaId}
    </update>

    <!-- =============================================
         4. 일일 사용량 조회
         ============================================= -->
    <select id="selectDailyUsage" resultMap="UsageResultMap">
        SELECT usage_id, user_idx, ip_address, period_start, message_count
        FROM CHATBOT_DAILY_USAGE
        WHERE period_start = #{periodStart}
          <choose>
              <when test="userIdx != null">AND user_idx = #{userIdx}</when>
              <otherwise>AND ip_address = #{ipAddress}</otherwise>
          </choose>
    </select>

    <!-- =============================================
         5. 일일 사용량 +1 (UPSERT)
         - UNIQUE (user_idx, usage_date) 또는 (anon_session_id, usage_date)
         - user_idx가 있으면 user_idx 기준, 없으면 anon_session_id 기준 upsert
         ============================================= -->
    <insert id="upsertDailyUsageIncrement">
        INSERT INTO CHATBOT_DAILY_USAGE
            (user_idx, ip_address, period_start, message_count)
        VALUES
            (#{userIdx}, #{ipAddress}, #{periodStart}, 1)
        ON DUPLICATE KEY UPDATE
            message_count = message_count + 1
    </insert>

    <!-- =============================================
         6. 일일 사용량 -N (대화 삭제 시 환급용)
         - 행 없으면 no-op, 음수 방지 GREATEST(0, ...)
         ============================================= -->
    <update id="decreaseDailyUsage">
        UPDATE CHATBOT_DAILY_USAGE
           SET message_count = GREATEST(0, message_count - #{amount})
         WHERE period_start = #{periodStart}
        <choose>
            <when test="userIdx != null">AND user_idx = #{userIdx}</when>
            <otherwise>AND ip_address = #{ipAddress}</otherwise>
        </choose>
    </update>

</mapper>
