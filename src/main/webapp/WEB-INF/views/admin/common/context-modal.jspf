<div class="adm-modal-overlay" id="adminMemberContextModal" onclick="closeAdminContextModal('adminMemberContextModal')">
    <div class="adm-modal adm-context-modal" onclick="event.stopPropagation()">
        <div class="adm-modal-head">
            <div class="adm-modal-title" id="adminMemberContextTitle">${msg_admin_context_memberTitle}</div>
            <button class="adm-modal-close" type="button" onclick="closeAdminContextModal('adminMemberContextModal')">✕</button>
        </div>
        <div class="adm-modal-body" id="adminMemberContextBody">
            <div class="adm-context-empty">${msg_admin_common_loading}</div>
        </div>
        <div class="adm-modal-foot">
            <button class="adm-btn adm-btn-ghost" type="button" onclick="closeAdminContextModal('adminMemberContextModal')">${msg_admin_common_close}</button>
        </div>
    </div>
</div>

<div class="adm-modal-overlay" id="adminIpContextModal" onclick="closeAdminContextModal('adminIpContextModal')">
