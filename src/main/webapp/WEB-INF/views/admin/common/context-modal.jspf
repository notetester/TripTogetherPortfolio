const ADMIN_CONTEXT_STATUS_LABELS = {
    ACTIVE: '${msg_admin_status_ACTIVE_js}',
    DORMANT: '${msg_admin_status_DORMANT_js}',
    BLOCKED: '${msg_admin_status_BLOCKED_js}',
    DELETED: '${msg_admin_status_DELETED_js}'
};
const ADMIN_CONTEXT_ROLE_LABELS = {
    USER: '${msg_admin_role_USER_js}',
    BUSINESS: '${msg_admin_role_BUSINESS_js}',
    PARTNER: '${msg_admin_role_PARTNER_js}',
    BOT: '${msg_admin_role_BOT_js}',
    ADMIN: '${msg_admin_role_ADMIN_js}',
    SUPERADMIN: '${msg_admin_role_SUPERADMIN_js}',
    SYSTEM: '${msg_admin_role_SYSTEM_js}'
};

function adminContextMessage(key) {
    return Object.prototype.hasOwnProperty.call(ADMIN_CONTEXT_MSG, key) ? ADMIN_CONTEXT_MSG[key] : key;
}

function formatAdminContextMessage(template, values) {
    return String(template || '').replace(/\{(\d+)}/g, function(_, index) {
        return values && values[index] != null ? values[index] : '';
    });
}

function escapeAdminContextHtml(value) {
    if (value == null) return '';
    return String(value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
}

function formatAdminContextDate(value) {
    if (!value) return adminContextMessage('dash');
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return escapeAdminContextHtml(value);
    return date.toLocaleString(ADMIN_CONTEXT_LOCALE, {
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
        hour: '2-digit',
        minute: '2-digit',
        hour12: false
    });
}

function formatAdminContextShortDate(value) {
    if (!value) return adminContextMessage('dash');
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return escapeAdminContextHtml(value);
    return date.toLocaleString(ADMIN_CONTEXT_LOCALE, {
        month: '2-digit',
        day: '2-digit',
        hour: '2-digit',
        minute: '2-digit',
        hour12: false
    });
}

function adminContextStatusLabel(value) {
    return ADMIN_CONTEXT_STATUS_LABELS[value] || escapeAdminContextHtml(value || adminContextMessage('dash'));
}

function adminContextRoleLabel(value) {
    return ADMIN_CONTEXT_ROLE_LABELS[value] || escapeAdminContextHtml(value || adminContextMessage('dash'));
}

function adminContextBooleanLabel(value) {
    return value ? adminContextMessage('yes') : adminContextMessage('no');
}

function adminContextActiveLabel(value) {
    return value ? adminContextMessage('active') : adminContextMessage('inactive');
}

function adminContextActionLabel(value) {
    if (value === 'ALLOW') return adminContextMessage('allow');
    if (value === 'BLOCK') return adminContextMessage('block');
    return escapeAdminContextHtml(value || adminContextMessage('dash'));
}

function adminContextLoadingHtml() {
    return '<div class="adm-context-empty">' + adminContextMessage('loading') + '</div>';
}

function adminContextErrorHtml(message) {
    return '<div class="adm-context-empty is-error">' + escapeAdminContextHtml(message) + '</div>';
}

function closeAdminContextModal(id) {
    const modal = document.getElementById(id);
    if (modal) modal.classList.remove('open');
}

function adminContextFetch(url) {
    return fetch(url, { headers: { 'Accept': 'application/json' } }).then(async function(response) {
        let data;
        try {
            data = await response.json();
        } catch (e) {
            throw new Error(adminContextMessage('fetchParseError'));
        }
        if (!response.ok || !data.success) {
            throw new Error((data && data.message) || adminContextMessage('fetchError'));
        }
        return data;
    });
}

function renderContextTimeline(items, renderItem, emptyMessage) {
    if (!Array.isArray(items) || !items.length) {
        return '<div class="adm-context-empty">' + emptyMessage + '</div>';
    }
    return '<div class="adm-context-stack">' + items.map(renderItem).join('') + '</div>';
}

function renderContextRecord(title, meta, lines, dangerText) {
    const renderedLines = (lines || []).filter(Boolean).map(function(line) {
        return '<div class="adm-context-record-line">' + line + '</div>';
    }).join('');
    return ''
        + '<div class="adm-context-record">'
        + '<div class="adm-context-record-head">'
        + '<div class="adm-context-record-title">' + title + '</div>'
        + '<div class="adm-context-record-meta">' + meta + '</div>'
        + '</div>'
        + renderedLines
        + (dangerText ? '<div class="adm-context-record-danger">' + dangerText + '</div>' : '')
        + '</div>';
}

function renderAdminContextSocialHtml(linkedProviders) {
    if (!linkedProviders) {
        return '<span class="adm-social-empty">${msg_admin_members_noLinkedProvider_js}</span>';
    }

    const providerMap = {
        KAKAO: {
            label: '${msg_admin_social_kakao_js}',
            className: 'kakao',
            icon: '<span class="adm-social-icon kakao-mark">k</span>'
        },
        NAVER: {
            label: '${msg_admin_social_naver_js}',
            className: 'naver',
            icon: '<span class="adm-social-icon naver-mark">N</span>'
        },
        GOOGLE: {
            label: '${msg_admin_social_google_js}',
            className: 'google',
            icon: '<span class="adm-social-icon google-mark"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.97 2.36-8.16 2.36-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg></span>'
        }
    };

    const items = String(linkedProviders)
        .split(',')
        .map(function(provider) { return provider.trim(); })
        .filter(function(provider) { return provider.length > 0; })
        .map(function(provider) {
            const info = providerMap[provider];
            if (!info) {
                return '<span class="adm-social-pill"><span class="adm-social-label">' + escapeAdminContextHtml(provider) + '</span></span>';
            }
            return '<span class="adm-social-pill ' + info.className + '">' + info.icon + '<span class="adm-social-label">' + escapeAdminContextHtml(info.label) + '</span></span>';
        });

    if (!items.length) {
        return '<span class="adm-social-empty">${msg_admin_members_noLinkedProvider_js}</span>';
    }

    return '<div class="adm-social-list">' + items.join('') + '</div>';
}

function renderMemberInfoCard(member) {
    return ''
        + '<div class="detail-grid">'
        + '<div class="detail-item"><div class="detail-label">' + adminContextMessage('memberNo') + '</div><div class="detail-value">#' + escapeAdminContextHtml(member.userIdx) + '</div></div>'
        + '<div class="detail-item"><div class="detail-label">' + adminContextMessage('userId') + '</div><div class="detail-value">' + (member.userId ? '@' + escapeAdminContextHtml(member.userId) : adminContextMessage('socialOnly')) + '</div></div>'
        + '<div class="detail-item"><div class="detail-label">' + adminContextMessage('nickname') + '</div><div class="detail-value">' + escapeAdminContextHtml(member.nickname || adminContextMessage('dash')) + '</div></div>'
        + '<div class="detail-item"><div class="detail-label">' + adminContextMessage('email') + '</div><div class="detail-value">' + escapeAdminContextHtml(member.userEmail || adminContextMessage('dash')) + '</div></div>'
        + '<div class="detail-item"><div class="detail-label">' + adminContextMessage('status') + '</div><div class="detail-value"><span class="status-badge ' + escapeAdminContextHtml(member.accountStatus || 'ACTIVE') + '">' + adminContextStatusLabel(member.accountStatus || 'ACTIVE') + '</span></div></div>'
        + '<div class="detail-item"><div class="detail-label">' + adminContextMessage('role') + '</div><div class="detail-value"><span class="role-badge ' + escapeAdminContextHtml(member.userRole || 'USER') + '">' + adminContextRoleLabel(member.userRole || 'USER') + '</span></div></div>'
        + '<div class="detail-item"><div class="detail-label">${msg_admin_members_social_js}</div><div class="detail-value">' + renderAdminContextSocialHtml(member.linkedProviders) + '</div></div>'
        + '<div class="detail-item"><div class="detail-label">' + adminContextMessage('nationality') + '</div><div class="detail-value">' + escapeAdminContextHtml(member.nationality || adminContextMessage('dash')) + '</div></div>'
        + '<div class="detail-item"><div class="detail-label">' + adminContextMessage('preferredLanguage') + '</div><div class="detail-value">' + escapeAdminContextHtml(member.preferredLang || adminContextMessage('dash')) + '</div></div>'
        + '<div class="detail-item"><div class="detail-label">' + adminContextMessage('createdAt') + '</div><div class="detail-value">' + formatAdminContextDate(member.createdAt) + '</div></div>'
        + '<div class="detail-item"><div class="detail-label">' + adminContextMessage('lastLogin') + '</div><div class="detail-value">' + formatAdminContextDate(member.lastLoginAt) + '</div></div>'
        + '</div>';
}

function renderLoginAuditItem(item) {
    return renderContextRecord(
        '<strong>' + escapeAdminContextHtml(item.eventType || 'LOGIN') + '</strong> <span class="adm-context-slash">/</span> ' + escapeAdminContextHtml(item.authProvider || item.authType || adminContextMessage('dash')),
        formatAdminContextShortDate(item.loginAt),
        [
            adminContextMessage('inputValue') + ': ' + escapeAdminContextHtml(item.loginIdentifier || adminContextMessage('dash')),
            'IP: ' + escapeAdminContextHtml(item.ipAddress || adminContextMessage('dash')) + ' <span class="adm-context-slash">/</span> ' + adminContextMessage('result') + ': ' + escapeAdminContextHtml(item.success ? adminContextMessage('success') : adminContextMessage('fail'))
        ],
        item.failReason ? escapeAdminContextHtml(item.failReason) : ''
    );
}

function renderSecurityAuditItem(item) {
    return renderContextRecord(
        '<strong>' + escapeAdminContextHtml(item.eventType || adminContextMessage('dash')) + '</strong> <span class="adm-context-slash">/</span> ' + escapeAdminContextHtml(item.eventStage || adminContextMessage('dash')),
        formatAdminContextShortDate(item.occurredAt),
        [
            adminContextMessage('inputValue') + ': ' + escapeAdminContextHtml(item.inputIdentifier || adminContextMessage('dash')),
            adminContextMessage('targetEmail') + ': ' + escapeAdminContextHtml(item.targetEmail || adminContextMessage('dash')) + ' <span class="adm-context-slash">/</span> ' + adminContextMessage('result') + ': ' + escapeAdminContextHtml(item.success ? adminContextMessage('success') : adminContextMessage('fail'))
        ],
        item.failReason ? escapeAdminContextHtml(item.failReason) : ''
    );
}

function renderEmailRequestItem(item) {
    return renderContextRecord(
        '<strong>' + escapeAdminContextHtml(item.purpose || adminContextMessage('dash')) + '</strong> <span class="adm-context-slash">/</span> ' + escapeAdminContextHtml(item.status || adminContextMessage('dash')),
        formatAdminContextShortDate(item.requestedAt),
        [
            adminContextMessage('requestEmail') + ': ' + escapeAdminContextHtml(item.pendingEmail || adminContextMessage('dash')),
            'IP: ' + escapeAdminContextHtml(item.ipAddress || adminContextMessage('dash')) + ' <span class="adm-context-slash">/</span> ' + adminContextMessage('requestId') + ': ' + escapeAdminContextHtml(item.requestId || adminContextMessage('dash'))
        ]
    );
}

function renderEmailTokenItem(item) {
    return renderContextRecord(
        '<strong>' + escapeAdminContextHtml(item.purpose || adminContextMessage('dash')) + '</strong> <span class="adm-context-slash">/</span> ' + escapeAdminContextHtml(item.used ? adminContextMessage('used') : adminContextMessage('unused')),
        formatAdminContextShortDate(item.createdAt),
        [
            adminContextMessage('targetEmail') + ': ' + escapeAdminContextHtml(item.email || adminContextMessage('dash')),
            adminContextMessage('expiresAt') + ': ' + formatAdminContextDate(item.expiredAt)
        ]
    );
}

function renderActivityItem(item) {
    return renderContextRecord(
        '<strong>' + escapeAdminContextHtml(item.activityCode || adminContextMessage('dash')) + '</strong> <span class="adm-context-slash">/</span> ' + escapeAdminContextHtml(item.activityDomain || item.activityType || adminContextMessage('dash')),
        formatAdminContextShortDate(item.createdAt),
        [
            adminContextMessage('uri') + ': ' + escapeAdminContextHtml(item.requestUri || adminContextMessage('dash')),
            'IP: ' + escapeAdminContextHtml(item.ipAddress || adminContextMessage('dash')) + ' <span class="adm-context-slash">/</span> ' + adminContextMessage('status') + ': ' + escapeAdminContextHtml(item.responseStatus || adminContextMessage('dash'))
        ]
    );
}

function renderUserBlockItem(item) {
    return renderContextRecord(
        '<strong>' + escapeAdminContextHtml(item.blockType || adminContextMessage('dash')) + '</strong> <span class="adm-context-slash">/</span> ' + escapeAdminContextHtml(item.active ? adminContextMessage('active') : adminContextMessage('inactive')),
        formatAdminContextShortDate(item.blockedAt),
        [
            adminContextMessage('reason') + ': ' + escapeAdminContextHtml(item.reason || adminContextMessage('dash')),
            adminContextMessage('blockedIp') + ': ' + escapeAdminContextHtml(item.blockedIp || adminContextMessage('dash'))
        ]
    );
}

function renderBlockHistoryItem(item) {
    return renderContextRecord(
        '<strong>' + escapeAdminContextHtml(item.historyKind || adminContextMessage('dash')) + '</strong> <span class="adm-context-slash">/</span> ' + escapeAdminContextHtml(item.blockType || item.ruleAction || adminContextMessage('dash')),
        formatAdminContextShortDate(item.blockedAt || item.createdAt),
        [
            adminContextMessage('reason') + ': ' + escapeAdminContextHtml(item.reason || item.controlReason || adminContextMessage('dash'))
        ]
    );
}

function renderIpRuleItem(item) {
    return renderContextRecord(
        '<strong>' + adminContextActionLabel(item.ruleAction) + '</strong> <span class="adm-context-slash">/</span> ' + escapeAdminContextHtml(item.matchType || adminContextMessage('dash')),
        escapeAdminContextHtml(item.effectiveStatus || adminContextMessage('dash')),
        [
            adminContextMessage('reason') + ': ' + escapeAdminContextHtml(item.reason || adminContextMessage('dash')),
            adminContextMessage('batch') + ': ' + escapeAdminContextHtml(item.batchName || adminContextMessage('dash')) + ' <span class="adm-context-slash">/</span> ' + adminContextMessage('priority') + ': ' + escapeAdminContextHtml(item.priority || adminContextMessage('dash'))
        ]
    );
}

function renderChatbotLinkItem(item) {
    const url = item.url || adminContextMessage('dash');
    const userLabel = item.userIdx
        ? ('#' + escapeAdminContextHtml(item.userIdx))
        : '<span style="color:#fbbf24;">' + escapeAdminContextHtml(adminContextMessage('anonymous')) + '</span>';
    return renderContextRecord(
        '<strong>' + escapeAdminContextHtml(item.label || adminContextMessage('dash')) + '</strong>',
        formatAdminContextShortDate(item.clickedAt),
        [
            'URL: <a href="' + escapeAdminContextHtml(url) + '" target="_blank" style="color:#60a5fa;font-family:monospace;text-decoration:none;">' + escapeAdminContextHtml(url) + '</a>',
            'conv #' + escapeAdminContextHtml(item.conversationId || adminContextMessage('dash'))
            + ' <span class="adm-context-slash">/</span> '
            + 'msg #' + escapeAdminContextHtml(item.messageId || adminContextMessage('dash'))
            + ' <span class="adm-context-slash">/</span> '
            + 'user ' + userLabel
        ]
    );
}

function switchAdminContextTab(modalId, tabId, button) {
    const modal = document.getElementById(modalId);
    modal.querySelectorAll('.adm-tab').forEach(function(tab) { tab.classList.remove('active'); });
    modal.querySelectorAll('.admin-context-tab-pane').forEach(function(pane) { pane.style.display = 'none'; });
    button.classList.add('active');
    const pane = modal.querySelector('[data-context-pane="' + tabId + '"]');
    if (pane) pane.style.display = '';
}

function buildMemberActions(member) {
    return ''
        + '<div class="adm-context-actions-grid">'
        + '<div class="adm-context-panel">'
        + '<div class="adm-context-panel-title">' + adminContextMessage('saveProfileSection') + '</div>'
        + '<div class="adm-filter-label">' + adminContextMessage('nickname') + '</div><input class="adm-input js-member-profile-nickname adm-input-inline" type="text" value="' + escapeAdminContextHtml(member.nickname || '') + '">'
        + '<div class="adm-filter-label">' + adminContextMessage('nationality') + '</div><input class="adm-input js-member-profile-nationality adm-input-inline" type="text" value="' + escapeAdminContextHtml(member.nationality || '') + '">'
        + '<div class="adm-filter-label">' + adminContextMessage('preferredLanguage') + '</div><input class="adm-input js-member-profile-language adm-input-inline" type="text" value="' + escapeAdminContextHtml(member.preferredLang || '') + '">'
        + '<button type="button" class="adm-btn adm-btn-primary adm-context-btn" onclick="saveAdminMemberProfile(' + escapeAdminContextHtml(member.userIdx) + ', this)">' + adminContextMessage('saveProfileButton') + '</button>'
        + '</div>'
        + '<div class="adm-context-panel">'
        + '<div class="adm-context-panel-title">' + adminContextMessage('statusRoleSection') + '</div>'
        + '<div class="adm-filter-label">' + adminContextMessage('status') + '</div>'
        + '<div class="adm-context-inline">'
        + '<select class="adm-select js-member-status adm-select-inline"><option value="ACTIVE">' + adminContextStatusLabel('ACTIVE') + '</option><option value="DORMANT">' + adminContextStatusLabel('DORMANT') + '</option><option value="BLOCKED">' + adminContextStatusLabel('BLOCKED') + '</option><option value="DELETED">' + adminContextStatusLabel('DELETED') + '</option></select>'
        + '<button type="button" class="adm-btn adm-btn-ghost" onclick="saveAdminMemberStatus(' + escapeAdminContextHtml(member.userIdx) + ', this)">' + adminContextMessage('applyButton') + '</button>'
        + '</div>'
        + '<div class="adm-filter-label">' + adminContextMessage('role') + '</div>'
        + '<select class="adm-select js-member-role adm-select-inline"><option value="USER">' + adminContextRoleLabel('USER') + '</option><option value="BUSINESS">' + adminContextRoleLabel('BUSINESS') + '</option><option value="PARTNER">' + adminContextRoleLabel('PARTNER') + '</option><option value="BOT">' + adminContextRoleLabel('BOT') + '</option><option value="ADMIN">' + adminContextRoleLabel('ADMIN') + '</option></select>'
        + '<div class="adm-filter-label">' + adminContextMessage('roleReason') + '</div>'
        + '<input class="adm-input js-member-role-reason adm-input-inline" type="text" maxlength="500" placeholder="' + adminContextMessage('roleReasonPlaceholder') + '">'
        + '<button type="button" class="adm-btn adm-btn-ghost adm-context-btn" onclick="saveAdminMemberRole(' + escapeAdminContextHtml(member.userIdx) + ', this)">' + adminContextMessage('changeRoleButton') + '</button>'
        + '</div>'
        + '<div class="adm-context-panel">'
        + '<div class="adm-context-panel-title">' + adminContextMessage('quickBlockSection') + '</div>'
        + '<div class="adm-filter-label">' + adminContextMessage('blockType') + '</div>'
        + '<select class="adm-select js-member-block-type adm-select-inline"><option value="USER_ONLY">' + adminContextMessage('userOnly') + '</option><option value="IP_ONLY">' + adminContextMessage('ipOnly') + '</option><option value="USER_IP">' + adminContextMessage('userIp') + '</option></select>'
        + '<div class="adm-filter-label">' + adminContextMessage('blockedIp') + '</div>'
        + '<input class="adm-input js-member-block-ip adm-input-inline" type="text" placeholder="' + adminContextMessage('blockIpPlaceholder') + '">'
        + '<div class="adm-filter-label">' + adminContextMessage('blockExpires') + '</div>'
        + '<input class="adm-input js-member-block-expires adm-input-inline" type="datetime-local">'
        + '<div class="adm-filter-label">' + adminContextMessage('reason') + '</div>'
        + '<textarea class="adm-input js-member-block-reason adm-context-textarea" placeholder="' + adminContextMessage('actionReasonPlaceholder') + '"></textarea>'
        + '<button type="button" class="adm-btn adm-btn-primary adm-context-btn" onclick="saveAdminMemberBlock(' + escapeAdminContextHtml(member.userIdx) + ', this)">' + adminContextMessage('blockButton') + '</button>'
        + '</div>'
        + '</div>';
}

function buildIpActions(ipAddress) {
    return ''
        + '<div class="adm-context-panel">'
        + '<div class="adm-context-panel-title">' + adminContextMessage('ipActionSection') + '</div>'
        + '<div class="adm-filter-label">' + adminContextMessage('targetIp') + '</div><div class="adm-context-code">' + escapeAdminContextHtml(ipAddress) + '</div>'
        + '<div class="adm-filter-label">' + adminContextMessage('ruleAction') + '</div>'
        + '<select class="adm-select js-ip-rule-action adm-select-inline"><option value="BLOCK">' + adminContextMessage('block') + '</option><option value="ALLOW">' + adminContextMessage('allow') + '</option></select>'
        + '<div class="adm-filter-label">' + adminContextMessage('category') + '</div>'
        + '<select class="adm-select js-ip-rule-category adm-select-inline"><option value="MANUAL">MANUAL</option><option value="SECURITY">SECURITY</option><option value="ABUSE">ABUSE</option><option value="SPAM">SPAM</option></select>'
        + '<div class="adm-filter-label">' + adminContextMessage('priority') + '</div>'
        + '<input class="adm-input js-ip-rule-priority adm-input-inline" type="number" min="1" max="9999" value="100">'
        + '<div class="adm-filter-label">' + adminContextMessage('expiresAt') + '</div>'
        + '<input class="adm-input js-ip-rule-expires adm-input-inline" type="datetime-local">'
        + '<div class="adm-filter-label">' + adminContextMessage('reason') + '</div>'
        + '<input class="adm-input js-ip-rule-reason adm-input-inline" type="text" maxlength="255" placeholder="' + adminContextMessage('actionReasonPlaceholder') + '">'
        + '<div class="adm-filter-label">' + adminContextMessage('detailMemo') + '</div>'
        + '<textarea class="adm-input js-ip-rule-detail adm-context-textarea" placeholder="' + adminContextMessage('detailMemoPlaceholder') + '"></textarea>'
        + '<button type="button" class="adm-btn adm-btn-primary adm-context-btn" onclick="saveAdminIpRule(\'' + escapeAdminContextHtml(ipAddress) + '\', this)">' + adminContextMessage('createPolicyButton') + '</button>'
        + '</div>';
}

function renderMemberContext(context, defaultTab) {
    const member = context.member || {};
    const tabs = [
        { key: 'info', label: adminContextMessage('infoTab'), content: renderMemberInfoCard(member) },
        { key: 'logins', label: adminContextMessage('loginTab'), content: renderContextTimeline(context.loginAudits || context.history || [], renderLoginAuditItem, adminContextMessage('emptyLoginHistory')) },
        { key: 'security', label: adminContextMessage('securityTab'), content: renderContextTimeline(context.securityAudits || [], renderSecurityAuditItem, adminContextMessage('emptySecurityHistory')) },
        { key: 'emailRequests', label: adminContextMessage('emailRequestTab'), content: renderContextTimeline(context.emailRequests || [], renderEmailRequestItem, adminContextMessage('emptyEmailRequests')) },
        { key: 'emailTokens', label: adminContextMessage('emailTokenTab'), content: renderContextTimeline(context.emailTokens || [], renderEmailTokenItem, adminContextMessage('emptyEmailTokens')) },
        { key: 'activity', label: adminContextMessage('activityTab'), content: renderContextTimeline(context.activityLogs || [], renderActivityItem, adminContextMessage('emptyActivity')) },
        { key: 'blocks', label: adminContextMessage('blockTab'), content: renderContextTimeline(context.recentBlocks || [], renderUserBlockItem, adminContextMessage('emptyBlocks')) },
        { key: 'actions', label: adminContextMessage('actionTab'), content: buildMemberActions(member) }
    ];
    const activeKey = tabs.some(function(tab) { return tab.key === defaultTab; }) ? defaultTab : 'info';
    return ''
        + '<div class="adm-tabs adm-tabs-scroll">' + tabs.map(function(tab) {
            return '<button type="button" class="adm-tab ' + (tab.key === activeKey ? 'active' : '') + '" onclick="switchAdminContextTab(\'adminMemberContextModal\', \'' + tab.key + '\', this)">' + tab.label + '</button>';
        }).join('') + '</div>'
        + tabs.map(function(tab) {
            return '<div class="admin-context-tab-pane" data-context-pane="' + tab.key + '" style="display:' + (tab.key === activeKey ? 'block' : 'none') + ';">' + tab.content + '</div>';
        }).join('');
}

function renderIpContext(context, defaultTab) {
    const ipAddress = context.ipAddress || adminContextMessage('dash');
    const tabs = [
        { key: 'logins', label: adminContextMessage('loginTab'), content: renderContextTimeline(context.loginAudits || [], renderLoginAuditItem, adminContextMessage('emptyLoginHistory')) },
        { key: 'security', label: adminContextMessage('securityTab'), content: renderContextTimeline(context.securityAudits || [], renderSecurityAuditItem, adminContextMessage('emptySecurityHistory')) },
        { key: 'emailRequests', label: adminContextMessage('emailRequestTab'), content: renderContextTimeline(context.emailRequests || [], renderEmailRequestItem, adminContextMessage('emptyEmailRequests')) },
        { key: 'emailTokens', label: adminContextMessage('emailTokenTab'), content: renderContextTimeline(context.emailTokens || [], renderEmailTokenItem, adminContextMessage('emptyEmailTokens')) },
        { key: 'activity', label: adminContextMessage('activityTab'), content: renderContextTimeline(context.activityLogs || [], renderActivityItem, adminContextMessage('emptyActivity')) },
        { key: 'blocks', label: adminContextMessage('blockTab'), content: renderContextTimeline(context.blockHistories || [], renderBlockHistoryItem, adminContextMessage('emptyIpBlockHistory')) + '<div class="adm-context-spacer"></div>' + renderContextTimeline(context.ipRules || [], renderIpRuleItem, adminContextMessage('emptyIpRules')) },
        { key: 'chatbot', label: adminContextMessage('chatbotTab'), content: renderContextTimeline(context.chatbotLinkClicks || [], renderChatbotLinkItem, adminContextMessage('emptyChatbotClicks')) },
        { key: 'actions', label: adminContextMessage('actionTab'), content: buildIpActions(ipAddress) }
    ];
    const activeKey = tabs.some(function(tab) { return tab.key === defaultTab; }) ? defaultTab : 'logins';
    return ''
        + '<div class="adm-context-summary">'
        + '<div class="adm-context-summary-label">' + adminContextMessage('targetIp') + '</div>'
        + '<div class="adm-context-summary-value">' + escapeAdminContextHtml(ipAddress) + '</div>'
        + '</div>'
        + '<div class="adm-tabs adm-tabs-scroll">' + tabs.map(function(tab) {
            return '<button type="button" class="adm-tab ' + (tab.key === activeKey ? 'active' : '') + '" onclick="switchAdminContextTab(\'adminIpContextModal\', \'' + tab.key + '\', this)">' + tab.label + '</button>';
        }).join('') + '</div>'
        + tabs.map(function(tab) {
            return '<div class="admin-context-tab-pane" data-context-pane="' + tab.key + '" style="display:' + (tab.key === activeKey ? 'block' : 'none') + ';">' + tab.content + '</div>';
        }).join('');
}

async function openAdminMemberContext(userIdx, defaultTab) {
    if (!userIdx) return;
    const modal = document.getElementById('adminMemberContextModal');
    const body = document.getElementById('adminMemberContextBody');
    modal.classList.add('open');
    document.getElementById('adminMemberContextTitle').textContent = adminContextMessage('memberTitle');
    body.innerHTML = adminContextLoadingHtml();
    try {
        const data = await adminContextFetch(ADMIN_CONTEXT_BASE + '/admin/members/' + encodeURIComponent(userIdx));
        body.innerHTML = renderMemberContext(data, defaultTab || 'info');
        const statusSelect = body.querySelector('.js-member-status');
        const roleSelect = body.querySelector('.js-member-role');
        if (statusSelect && data.member) statusSelect.value = data.member.accountStatus || 'ACTIVE';
        if (roleSelect && data.member) roleSelect.value = data.member.userRole || 'USER';
    } catch (error) {
        body.innerHTML = adminContextErrorHtml(error.message || adminContextMessage('fetchError'));
    }
}

async function openAdminIpContext(ipAddress, defaultTab) {
    if (!ipAddress) return;
    const modal = document.getElementById('adminIpContextModal');
    const body = document.getElementById('adminIpContextBody');
    modal.classList.add('open');
    document.getElementById('adminIpContextTitle').textContent = adminContextMessage('ipTitle');
    body.innerHTML = adminContextLoadingHtml();
    try {
        const data = await adminContextFetch(ADMIN_CONTEXT_BASE + '/admin/ips/context?ipAddress=' + encodeURIComponent(ipAddress));
        body.innerHTML = renderIpContext(data, defaultTab || 'logins');
    } catch (error) {
        body.innerHTML = adminContextErrorHtml(error.message || adminContextMessage('fetchError'));
    }
}

async function saveAdminMemberProfile(userIdx, button) {
    const card = button.closest('.admin-context-tab-pane');
    const nickname = card.querySelector('.js-member-profile-nickname').value.trim();
    const nationality = card.querySelector('.js-member-profile-nationality').value.trim();
    const preferredLang = card.querySelector('.js-member-profile-language').value.trim();
    button.disabled = true;
    try {
        const response = await fetch(ADMIN_CONTEXT_BASE + '/admin/members/' + userIdx + '/profile', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8' },
            body: new URLSearchParams({ nickname, nationality, preferredLang })
        });
        const data = await response.json();
        if (response.ok && data.success) {
            adm_toast(adminContextMessage('saveProfileSuccess'));
            setTimeout(function() { location.reload(); }, 600);
        } else {
            adm_toast(adminContextMessage('saveProfileFail'), 'error');
        }
    } catch (error) {
        console.error(error);
        adm_toast(adminContextMessage('saveProfileError'), 'error');
    } finally {
        button.disabled = false;
    }
}

async function saveAdminMemberStatus(userIdx, button) {
    const card = button.closest('.admin-context-tab-pane');
    const status = card.querySelector('.js-member-status').value;
    if (!confirm(formatAdminContextMessage(adminContextMessage('confirmStatusChange'), [adminContextStatusLabel(status)]))) return;
    button.disabled = true;
    try {
        const response = await fetch(ADMIN_CONTEXT_BASE + '/admin/members/' + userIdx + '/status', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8' },
            body: new URLSearchParams({ status })
        });
        const data = await response.json();
        if (response.ok && data.success) {
            adm_toast(adminContextMessage('saveStatusSuccess'));
            setTimeout(function() { location.reload(); }, 600);
        } else {
            adm_toast(adminContextMessage('saveStatusFail'), 'error');
        }
    } catch (error) {
        console.error(error);
        adm_toast(adminContextMessage('saveStatusError'), 'error');
    } finally {
        button.disabled = false;
    }
}

async function saveAdminMemberRole(userIdx, button) {
    const card = button.closest('.admin-context-tab-pane');
    const role = card.querySelector('.js-member-role').value;
    const reason = card.querySelector('.js-member-role-reason').value.trim();
    if (!reason) {
        adm_toast(adminContextMessage('requireRoleReason'), 'error');
        return;
    }
    button.disabled = true;
    try {
        const response = await fetch(ADMIN_CONTEXT_BASE + '/admin/members/' + userIdx + '/role', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8' },
            body: new URLSearchParams({ role, reason })
        });
        const data = await response.json();
        if (response.ok && data.success) {
            adm_toast(adminContextMessage('saveRoleSuccess'));
            setTimeout(function() { location.reload(); }, 600);
        } else {
            adm_toast(adminContextMessage('saveRoleFail'), 'error');
        }
    } catch (error) {
        console.error(error);
        adm_toast(adminContextMessage('saveRoleError'), 'error');
    } finally {
        button.disabled = false;
    }
}

async function saveAdminMemberBlock(userIdx, button) {
    const card = button.closest('.admin-context-tab-pane');
    const blockType = card.querySelector('.js-member-block-type').value;
    const blockedIp = card.querySelector('.js-member-block-ip').value.trim();
    const expiresAt = card.querySelector('.js-member-block-expires').value;
    const reason = card.querySelector('.js-member-block-reason').value.trim();
    if ((blockType === 'IP_ONLY' || blockType === 'USER_IP') && !blockedIp) {
        adm_toast(adminContextMessage('requireBlockedIp'), 'error');
        return;
    }
    button.disabled = true;
    try {
        const response = await fetch(ADMIN_CONTEXT_BASE + '/admin/members/' + userIdx + '/block', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8' },
            body: new URLSearchParams({ blockType, blockedIp, expiresAt, reason })
        });
        const data = await response.json();
        if (response.ok && data.success) {
            adm_toast(adminContextMessage('saveBlockSuccess'));
            setTimeout(function() { location.reload(); }, 600);
        } else {
            adm_toast(adminContextMessage('saveBlockFail'), 'error');
        }
    } catch (error) {
        console.error(error);
        adm_toast(adminContextMessage('saveBlockError'), 'error');
    } finally {
        button.disabled = false;
    }
}

async function saveAdminIpRule(ipAddress, button) {
    const card = button.closest('.admin-context-tab-pane');
    const ruleAction = card.querySelector('.js-ip-rule-action').value;
    const blockCategory = card.querySelector('.js-ip-rule-category').value;
    const priority = card.querySelector('.js-ip-rule-priority').value;
    const expiresAt = card.querySelector('.js-ip-rule-expires').value;
    const reason = card.querySelector('.js-ip-rule-reason').value.trim();
    const detailMessage = card.querySelector('.js-ip-rule-detail').value.trim();
    if (!reason) {
        adm_toast(adminContextMessage('requirePolicyReason'), 'error');
        return;
    }
    button.disabled = true;
    try {
        const response = await fetch(ADMIN_CONTEXT_BASE + '/admin/blocks/ip-rules', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8' },
            body: new URLSearchParams({
                matchType: 'SINGLE_IP',
                ipAddress: ipAddress,
                ruleAction: ruleAction,
                controlMode: 'MANUAL',
                blockCategory: blockCategory,
                priority: priority || '100',
                reason: reason,
                detailMessage: detailMessage,
                expiresAt: expiresAt
            })
        });
        const data = await response.json();
        if (response.ok && data.success) {
            adm_toast(adminContextMessage('savePolicySuccess'));
            setTimeout(function() { location.reload(); }, 600);
        } else {
            adm_toast(adminContextMessage('savePolicyFail'), 'error');
        }
    } catch (error) {
        console.error(error);
        adm_toast(adminContextMessage('savePolicyError'), 'error');
    } finally {
        button.disabled = false;
    }
}

document.addEventListener('click', function(event) {
    const memberTrigger = event.target.closest('.js-open-member-context');
    if (memberTrigger) {
        openAdminMemberContext(memberTrigger.dataset.userIdx, memberTrigger.dataset.defaultTab || 'info');
        return;
    }
    const ipTrigger = event.target.closest('.js-open-ip-context');
    if (ipTrigger) {
        openAdminIpContext(ipTrigger.dataset.ipAddress, ipTrigger.dataset.defaultTab || 'logins');
    }
});
</script>
